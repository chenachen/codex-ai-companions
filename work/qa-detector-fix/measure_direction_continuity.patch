 def transparent_hole_rows(image: Image.Image) -> list[dict[str, int]]:
     alpha = list(image.getchannel("A").getdata())
     rows = [alpha[index * CELL_WIDTH : (index + 1) * CELL_WIDTH] for index in range(CELL_HEIGHT)]
+
+    # Only enclosed transparency is an interior hole. A silhouette's open
+    # leg, sleeve, or tail gaps remain connected to the cell background.
+    exterior: set[tuple[int, int]] = set()
+    pending: list[tuple[int, int]] = []
+    for y in range(CELL_HEIGHT):
+        for x in range(CELL_WIDTH):
+            if (x in (0, CELL_WIDTH - 1) or y in (0, CELL_HEIGHT - 1)) and rows[y][x] <= 16:
+                exterior.add((x, y))
+                pending.append((x, y))
+    while pending:
+        x, y = pending.pop()
+        for nx, ny in ((x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1)):
+            if (
+                0 <= nx < CELL_WIDTH
+                and 0 <= ny < CELL_HEIGHT
+                and rows[ny][nx] <= 16
+                and (nx, ny) not in exterior
+            ):
+                exterior.add((nx, ny))
+                pending.append((nx, ny))
+
+    # A horizontal cut can reach the exterior, so flood-fill alone is not
+    # sufficient. Find opaque support above and below each pixel, including
+    # across completely empty scanlines in a multi-row cut.
+    above = [[-1] * CELL_WIDTH for _ in range(CELL_HEIGHT)]
+    below = [[CELL_HEIGHT] * CELL_WIDTH for _ in range(CELL_HEIGHT)]
+    for x in range(CELL_WIDTH):
+        previous = -1
+        for y in range(CELL_HEIGHT):
+            above[y][x] = previous
+            if rows[y][x] > 16:
+                previous = y
+        following = CELL_HEIGHT
+        for y in range(CELL_HEIGHT - 1, -1, -1):
+            below[y][x] = following
+            if rows[y][x] > 16:
+                following = y
+
     holes = []
     for y in range(1, CELL_HEIGHT - 1):
+        interior = {
+            x for x, value in enumerate(rows[y]) if value <= 16 and (x, y) not in exterior
+        }
+        supported = {
+            x for x, value in enumerate(rows[y])
+            if value <= 16 and (x, y) in exterior
+            and above[y][x] >= 0 and below[y][x] < CELL_HEIGHT
+        }
